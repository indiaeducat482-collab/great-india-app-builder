rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth != null;}
    function admin(){return signedIn() && request.auth.token.email == "admin@greatindia.technology";}

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow update: if signedIn() && (request.auth.uid == uid || admin());
      allow delete: if admin();
    }

    match /usage/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || admin());
      allow delete: if admin();
    }

    match /adminRequests/{uid} {
      allow create, read: if signedIn() && (request.auth.uid == uid || admin());
      allow update: if admin();
      allow delete: if admin();
    }

    match /appHistory/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow update: if signedIn() && (resource.data.uid == request.auth.uid || admin());
    }
  }
}